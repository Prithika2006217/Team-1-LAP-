# ---------------------------------------------------------------------------
# Tenzorce Backend — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Neon serverless PostgreSQL.
# DATABASE_URL is the POOLED connection (PgBouncer) used by the running app —
# it prevents connection-limit exhaustion under concurrent exam load.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"

# DIRECT_URL is the NON-pooled connection. Prisma uses it for migrations only,
# because migrations need a stable, direct session (PgBouncer breaks them).
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Upstash Redis (in-memory cache / live-exam auto-save buffer).
REDIS_URL="rediss://default:PASSWORD@HOST:PORT"

# Secret used to sign/verify JWTs. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-secret"

# Port the Express API listens on.
PORT=5000

# Public URL of the Next.js frontend — used to configure CORS.
FRONTEND_URL="http://localhost:3000"

# Gemini question generation for Study Space assessments.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
